# 复制为 .env.local 并按需修改（NEXT_PUBLIC_ 前缀变量在构建期注入静态产物）

# 子路径部署（如 GitHub Pages），留空则部署在域名根路径
# NEXT_PUBLIC_BASE_PATH=

# 腾讯地图 key（联系页地图使用，免费申请：https://lbs.qq.com/）
# 申请 WebServiceAPI/WebSocketGL 类型的 Web 应用 key，并配置域名白名单（如 www.poxiaoshi.cn）
NEXT_PUBLIC_TENCENT_MAP_KEY=

# Web3Forms access key（联系表单收集，免费申请：https://web3forms.com/）
# 用接收邮箱（support@xiaoshiai.cn）激活后获取；未配置时表单降级为 mailto 提交
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# 腾讯兔小巢产品 ID（联系页反馈入口，微信/QQ 登录 txc.qq.com 创建产品后获取）
# 配置后联系页表单区替换为兔小巢反馈入口（国内直连）；未配置时保留 Web3Forms/mailto 表单
NEXT_PUBLIC_TXC_PRODUCT_ID=
